<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what may leave the phone. Pictures (files/) stay local; settings may be backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
